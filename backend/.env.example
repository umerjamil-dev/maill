PORT=8080
DATABASE_URL=postgres://emailsender:emailsender@localhost:5432/emailsender?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=
